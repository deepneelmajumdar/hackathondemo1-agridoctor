# ============================================================
# Agri Doctor – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# IMPORTANT: Never commit .env to version control.
# Add .env to your .gitignore before pushing to any repository.

# -----------------------------------------------------------
# Replicate API (IBM Granite vision model provider)
# -----------------------------------------------------------
REPLICATE_API_TOKEN=your_replicate_api_token_here

# -----------------------------------------------------------
# Groq API (fallback / text-only LLM)
# -----------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------
# Model configuration (keep configurable - do NOT hardcode)
# -----------------------------------------------------------
# Vision model used by Pathologist Agent via Replicate
# IBM Granite Vision on Replicate:
VISION_MODEL=ibm-granite/granite-3-2-vision-instruct

# Text model used by Extension Officer Agent via Replicate
# IBM Granite 4 on Replicate:
TEXT_MODEL=ibm-granite/granite-4-0-tiny-preview

# Replicate API base URL (OpenAI-compatible predictions endpoint)
REPLICATE_API_URL=https://api.replicate.com/v1/models

# -----------------------------------------------------------
# Guardrail / safety settings
# -----------------------------------------------------------
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=jpg,jpeg,png
MAX_INPUT_TOKENS=2000
MAX_OUTPUT_TOKENS=1500
MAX_AGENT_ITERATIONS=5
MAX_EXECUTION_TIME_SECONDS=120
API_RATE_LIMIT_PER_MINUTE=10

# -----------------------------------------------------------
# Operational settings
# -----------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_AUDIT_TRAIL=true
ENABLE_COST_MONITORING=true
COST_BUDGET_LIMIT_USD=5.0
